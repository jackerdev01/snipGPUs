# snipGPU - secret cua ban. Dien roi chay lai bot. Nen tang nao khong dung thi de trong.

# Telegram (bat buoc): tao bot qua @BotFather, chat_id lay qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vi dao (bat buoc PRL; QTC chi khi bat qtc.enabled). Bot tu dien vao moi config_*.yaml
PRL_WALLET=
QTC_WALLET=

# Vast.ai - dang ky: https://cloud.vast.ai/?ref_id=716525 · key: Account > API Keys
VAST_API_KEY=

# Clore.ai - dang ky: https://clore.ai/register?ref_id=6ph9tvyq · key: Profile > API
CLORE_API_KEY=

# QuickPod - dang ky: https://console.quickpod.io?affiliate=303bbe95-4783-4a7d-ad33-98a8da2aec40 · key: Account > API Key
QUICKPOD_API_KEY=

# SaladCloud - https://portal.salad.com (API key, ten organization va project)
SALAD_API_KEY=
SALAD_ORG=
SALAD_PROJECT=

# Tuy chon: gia coin truc tiep tu SafeTrade / CoinGecko
SAFETRADE_API_KEY=
SAFETRADE_API_SECRET=
COINGECKO_API_KEY=
